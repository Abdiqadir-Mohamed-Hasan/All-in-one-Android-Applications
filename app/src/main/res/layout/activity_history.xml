<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/historyMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="28dp">

            <!-- Top Header Bar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <ImageButton
                    android:id="@+id/btnBackHistory"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_status_pill_ready"
                    android:contentDescription="@string/back"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/text_primary" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:layout_toEndOf="@id/btnBackHistory"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="History of Somalia"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Stages of Somali Governance &amp; Statehood"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

            </RelativeLayout>

            <!-- Hero Banner Image: Real Laas Geel Ancient Cave Art -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Laas Geel Prehistoric Rock Art"
                    android:scaleType="centerCrop"
                    android:src="@drawable/laas_geel" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/scrim_gradient_bottom"
                    android:gravity="bottom"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Real Historical Site: Laas Geel Cave Paintings (c. 3,500 BC)"
                        android:textColor="@color/white"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION HEADER: STAGES OF SOMALI GOVERNMENT -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="STAGES OF SOMALI GOVERNMENT"
                android:textColor="#059669"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- Stage 1: Ancient & Sultanate Governance -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="Ancient Era"
                            android:src="@drawable/ic_category_history"
                            app:tint="@color/color_active_green" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Stage 1: Ancient &amp; Sultanates Era"
                            android:textColor="@color/text_primary"
                            android:textSize="16.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="4dp"
                        android:text="• Land of Punt (c. 2500 BC): Ancient mercantile state trading frankincense and gold with Pharaohs of Egypt.\n• Ajuran Sultanate (13th–17th Century): Centralized hydraulic empire governing southern river valleys with stone fortresses and tax administration.\n• Adal Sultanate (1415–1577): Islamic realm under Imam Ahmad Gurey that engaged in international diplomacy with Ottoman Turkey."
                        android:textColor="@color/text_secondary"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stage 2: Colonial Era & Partition -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="Colonial Era"
                            android:src="@drawable/ic_capitol_building"
                            app:tint="@color/color_active_green" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Stage 2: Colonial Era &amp; Dervish State"
                            android:textColor="@color/text_primary"
                            android:textSize="16.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="4dp"
                        android:text="• Colonial Partition (Late 19th C.): Divided into British Somaliland Protectorate in the north and Italian Somaliland in the south.\n• Dervish State (1899–1920): Anti-colonial movement led by Sayid Mohamed Abdullah Hassan that successfully resisted British, Italian, and Abyssinian forces for over two decades from Taleh fort."
                        android:textColor="@color/text_secondary"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stage 3: Independence & Democracy -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="Independence"
                            android:src="@drawable/ic_somalia_flag" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Stage 3: Independence &amp; Democracy (1960–1969)"
                            android:textColor="@color/text_primary"
                            android:textSize="16.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="4dp"
                        android:text="• July 1, 1960: Unification of British Somaliland and Italian Somaliland to form the independent Somali Republic.\n• Civilian Democracy: Led by first President Aden Abdullah Osman Daar (Aden Adde) and second President Abdirashid Ali Shermarke—noted as one of Africa's earliest peaceful democratic transitions of power."
                        android:textColor="@color/text_secondary"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stage 4: Military Rule & SRC -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="Military Rule"
                            android:src="@drawable/ic_star"
                            app:tint="#D97706" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Stage 4: Military Rule &amp; SRC (1969–1991)"
                            android:textColor="@color/text_primary"
                            android:textSize="16.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="4dp"
                        android:text="• Supreme Revolutionary Council (SRC): Major General Mohamed Siad Barre assumed power in October 1969.\n• Literacy &amp; Script (1972): Official adoption of the Latin script for the Somali language, triggering nationwide rural literacy campaigns.\n• Infrastructure: Expansion of ports, roads, state agriculture, and national defense."
                        android:textColor="@color/text_secondary"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stage 5: Federal Republic -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="Federal Republic"
                            android:src="@drawable/ic_location_pin"
                            app:tint="#2563EB" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Stage 5: Federal Republic (2000–Present)"
                            android:textColor="@color/text_primary"
                            android:textSize="16.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="4dp"
                        android:text="• Reconciliation Conferences: Arta Conference (2000) and establishment of Transitional Federal Government (TFG).\n• 2012 Federal Constitution: Formal establishment of the Federal Government of Somalia, rebuilding national public institutions, central banking, and international diplomatic relations."
                        android:textColor="@color/text_secondary"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>